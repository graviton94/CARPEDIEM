<?xml version="1.0" encoding="utf-8"?>
<!-- 폰을 바꿔도 기록이 남게 (Android 12+): 설정 · 오늘의 한 줄 · 가족의 돌 (shared_prefs/carpediem.xml) 만. 하루는 번호로 다시 그리므로 그림 파일은 없다. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="carpediem.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="carpediem.xml" />
    </device-transfer>
</data-extraction-rules>
