<?xml version="1.0" encoding="utf-8"?>
<!-- 폰을 바꿔도 기록이 남게 (Android 12+): 설정 · 오늘의 한 줄 · 가족의 돌 (shared_prefs/carpediem.xml) 과 한 줄의 사진 (files/photos).
     무엇을 넣을지는 GardenBackupAgent 가 고름: 클라우드는 한도 안에서 최근 사진부터 (기록은 늘), 폰끼리 옮길 때는 모두.
     여기 범위는 되살릴 때 받아들일 자리 (이 밖의 파일은 되살리지 않음). 파일로 내보내기에는 늘 사진 모두. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="carpediem.xml" />
        <include domain="file" path="photos/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="carpediem.xml" />
        <include domain="file" path="photos/" />
    </device-transfer>
</data-extraction-rules>
