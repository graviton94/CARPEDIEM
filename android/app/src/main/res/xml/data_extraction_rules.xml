<?xml version="1.0" encoding="utf-8"?>
<!-- 폰을 바꿔도 기록이 남게 (Android 12+): 설정 · 오늘의 한 줄 · 가족의 돌 (shared_prefs/carpediem.xml).
     한 줄의 사진 (files/photos) 은 폰끼리 옮길 때만 (클라우드 백업은 용량 한도가 있어 넣지 않음, 파일로 내보내기에는 늘 포함). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="carpediem.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="carpediem.xml" />
        <include domain="file" path="photos/" />
    </device-transfer>
</data-extraction-rules>
