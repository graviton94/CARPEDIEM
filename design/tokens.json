{
  "$schema": "Carpe Diem design tokens v1 — 단위: pt(iOS) = dp/sp(Android). 이 파일이 유일한 원본이며 Swift·Kotlin 코드는 여기서 생성한다.",
  "space": {
    "sp1": 4,
    "sp2": 8,
    "sp3": 12,
    "sp4": 16,
    "sp5": 20,
    "sp6": 24,
    "sp8": 32,
    "sp10": 40
